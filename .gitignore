# Godot 4
.godot/
/android/

# dot-core is a separate repository. For local development, symlink it:
#   ln -s ../../dot-core/addons/dot_core addons/dot_core
# Consumers copy both addons into their own project.
/addons/dot_core
# dot-server, for examples/session_reporter_selftest.tscn only (the addon never names it):
#   ln -s ../../dot-server/addons/dot_server addons/dot_server
/addons/dot_server

# Exports
build/
export_presets.cfg

# Signing keys and credentials must never be committed.
*.key
*.pem
keys/
dot_auth*.json

# OS
.DS_Store
Thumbs.db
